{
  "name": "gallstone-risk-dashboard",
  "version": "0.1.0",
  "homepage": ".",
  "private": true,
  "proxy": "http://localhost:5000",
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "axios": "^1.13.2",
    "cors": "^2.8.6",
    "express": "^4.21.2",
    "papaparse": "^5.5.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-icons": "^5.5.0",
    "react-router-dom": "^7.10.0",
    "react-scripts": "5.0.1",
